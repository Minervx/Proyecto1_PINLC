{
  "name": "pin-lc-task-api",
  "version": "1.0.0",
  "description": "Aplicacion base (generada con asistencia de IA) para el Proyecto Integrador Final - API de tareas con metricas Prometheus",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --coverage",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
