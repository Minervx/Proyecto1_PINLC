{
  "title": "PIN-LC Task API - Métricas básicas",
  "uid": "pin-lc-task-api",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests por segundo",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(pinlc_app_http_request_duration_seconds_count[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia p95 (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pinlc_app_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de errores (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(pinlc_app_http_request_duration_seconds_count{status_code=~\"5..\"}[5m]))",
          "legendFormat": "errores 5xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memoria del proceso (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "pinlc_app_process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    }
  ]
}
